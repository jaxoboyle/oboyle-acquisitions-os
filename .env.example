# O'Boyle Acquisition Operating System — Environment Variables
# Copy this file to .env.local and fill in all values before running.
# NEVER commit the actual .env.local file to git.

# ─── Supabase ────────────────────────────────────────────────────────────────

# Your Supabase project URL
# Found at: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe to expose to the browser
# Found at: Supabase dashboard → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SERVER-SIDE ONLY, NEVER in browser or client code
# Found at: Supabase dashboard → Settings → API → service_role secret
# Used for: data migration script, Edge Functions, server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic / Claude ──────────────────────────────────────────────────────

# Anthropic API key — SERVER-SIDE ONLY, NEVER in browser or Tauri frontend
# Get at: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use for Big Stein
# Current recommended model: claude-sonnet-4-6
# See https://docs.anthropic.com/en/docs/about-claude/models for latest
ANTHROPIC_MODEL=claude-sonnet-4-6

# Monthly AI token budget (approximate, stops new requests when exceeded)
# Set to 0 to disable the limit
ANTHROPIC_MONTHLY_TOKEN_LIMIT=1000000

# ─── Push Notifications (VAPID) ──────────────────────────────────────────────

# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is safe to expose to the browser (it's meant to be public)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# VAPID private key — SERVER-SIDE ONLY
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# Contact email for VAPID (used in push service header)
VAPID_SUBJECT=mailto:your-email@example.com

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — never expose these in client-side code. Task reminders,
# morning plan, overdue alerts, evening review, and weekly report texts are
# sent through these credentials. Get them at: console.twilio.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Application ─────────────────────────────────────────────────────────────

# Full URL of the deployed web app (used for push notification click URLs)
# Example: https://big-stein.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Environment: development | staging | production
NODE_ENV=development

# ─── Optional: Web Research ──────────────────────────────────────────────────

# If you add a web search provider (e.g., Brave Search API, Tavily):
# BRAVE_SEARCH_API_KEY=your-key-here
# TAVILY_API_KEY=your-key-here

# ─── Optional: Vercel (for production deployment) ────────────────────────────

# Set by Vercel automatically. Only needed if running locally with Vercel CLI.
# VERCEL_URL=your-project.vercel.app
